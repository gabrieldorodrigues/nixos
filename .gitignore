# Build artifacts / symlinks
result
result-*

# Editor / OS cruft
*.swp
*~
.DS_Store

# Local backups
*.bak
*.hm-bak
configuration.nix.save
flake.nix.bak

# Secrets (não versionar)
*.key
*.pem
secrets/

# Listas IPTV (geradas localmente, não versionar)
*.m3u
*.m3u8

# Config do editor (VS Code) — específica da máquina, não versionar
.vscode/

# Wallpapers — mantidos apenas localmente (não versionar). São expostos por
# symlink absoluto (/etc/nixos/home/wallpapers → ~/Pictures/wallpaper) e não
# entram na store do Nix, então ignorá-los não quebra o build.
home/wallpapers/
